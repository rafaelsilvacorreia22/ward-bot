{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ward-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },
  // Domínio próprio. O endereço antigo (ward-bot.ghostbot.workers.dev)
  // continua respondendo, para links já espalhados não quebrarem.
  "routes": [
    { "pattern": "wardbot.com.br", "custom_domain": true },
    { "pattern": "www.wardbot.com.br", "custom_domain": true }
  ],
  // Sem isto, ter "routes" desliga o *.workers.dev por padrão — e o
  // endereço antigo para de responder (aconteceu no primeiro deploy com o
  // domínio, por alguns segundos).
  "workers_dev": true,
  "vars": {
    "DISCORD_CLIENT_ID": "1554155800099037184",
    "DISCORD_PUBLIC_KEY": "b965f17aab300a2c003fd8cdf4552751b50e5cd2a3002a9b49e3e6b7bc5b4b2b"
  },
  // A cada 15 minutos: confere se saiu patch novo do LoL (Data Dragon, sem
  // chave) e notícias. A cada 2 minutos: coleta partidas para o /build (precisa
  // da chave da Riot — ver README). O texto do segundo tem que bater com
  // CRON_COLETA em src/index.js.
  "triggers": {
    "crons": ["*/15 * * * *", "*/2 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  // Limite de /build, /build-aram e /counter: 20 por minuto por servidor.
  // Impede que um servidor sozinho (de contas falsas, por exemplo) gaste a
  // cota diária grátis do Worker e derrube o bot para todo mundo.
  "ratelimits": [
    {
      "name": "LIMITE_COMANDOS",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ward-bot",
      "database_id": "30ae9568-3748-407c-b823-9c7a853324c7"
    }
  ]
}
